# Dashboard + API proxy. ${BACKEND_HOST} and ${NGINX_RESOLVER} are filled in
# from the environment when the container starts (see frontend/Dockerfile).

# https as seen by the client: Caddy (production) terminates TLS and says so in
# X-Forwarded-Proto; without it (local), this nginx is the edge
map $http_x_forwarded_proto $client_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
map $client_proto $hsts {
    https   "max-age=31536000; includeSubDomains";
    default "";
}
# Keep the client chain Caddy started; local requests start one here
map $http_x_forwarded_for $client_forwarded_for {
    default "$http_x_forwarded_for, $remote_addr";
    ""      $remote_addr;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend ${BACKEND_HOST};

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # GitHub webhooks may be up to 10 MB; the backend enforces its own limits
    client_max_body_size 11m;

    # The container's own liveness (not the backend's)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Everything the backend answers. A variable in proxy_pass makes nginx
    # resolve the backend per request and pass the URI through unchanged.
    location ~ ^/(api(/|$)|docs(/|$)|redoc$|openapi\.json$) {
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        # The client's Host header is not passed on (nginx sends the backend's
        # own name): the backend builds links from DASHBOARD_URL, never from it
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $client_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        # Live pipeline events are server-sent events: no buffering, long reads
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 5m;
    }

    # Hashed build files never change: cache for a year
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The single-page app (hash routing); index.html is always revalidated so a
    # deploy is picked up on the next load
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
