{
  "$defs": {
    "ActionType": {
      "description": "All browser actions a Step can perform.",
      "enum": [
        "goto",
        "click",
        "fill",
        "press",
        "select",
        "assert_text",
        "assert_visible",
        "wait_for"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "BoundingBox": {
      "description": "Pixel coordinates and dimensions of an element in the viewport.",
      "properties": {
        "x": {
          "description": "Left edge, pixels from viewport origin",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Top edge, pixels from viewport origin",
          "title": "Y",
          "type": "number"
        },
        "width": {
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "minimum": 0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ElementFingerprint": {
      "description": "Rich DOM snapshot captured when an element is successfully located.\n\nUsed by the healer to score live-DOM candidates against a previously\nknown element, even after the original locator breaks.",
      "properties": {
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTML tag name, lower-cased (e.g. 'button')",
          "title": "Tag"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Element id attribute",
          "title": "Id"
        },
        "classes": {
          "description": "CSS class list",
          "items": {
            "type": "string"
          },
          "title": "Classes",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Visible inner text, stripped",
          "title": "Text"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ARIA role attribute or implicit role",
          "title": "Role"
        },
        "aria_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "aria-label attribute value",
          "title": "Aria Label"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name attribute (inputs, forms, etc.)",
          "title": "Name"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "placeholder attribute",
          "title": "Placeholder"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Any other relevant HTML attributes (data-*, type, href, ...)",
          "title": "Attributes",
          "type": "object"
        },
        "parent_chain": {
          "description": "Ordered list of ancestor tag#id.class strings, nearest first",
          "items": {
            "type": "string"
          },
          "title": "Parent Chain",
          "type": "array"
        },
        "sibling_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-based index among same-tag siblings within the parent",
          "title": "Sibling Index"
        },
        "bounding_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Viewport bounding box at time of capture"
        }
      },
      "title": "ElementFingerprint",
      "type": "object"
    },
    "Target": {
      "description": "Fully-described element address.\n\nMember 1 can populate `primary_locator` and `fallback_locators` from\ntheir planner; Member 2 (engine) enriches `fingerprint` after a\nsuccessful locate.",
      "properties": {
        "description": {
          "description": "Human-readable description of the element (for logs/reports)",
          "title": "Description",
          "type": "string"
        },
        "primary_locator": {
          "description": "First locator to try (CSS selector, XPath, role string, ...)",
          "title": "Primary Locator",
          "type": "string"
        },
        "fallback_locators": {
          "description": "Ordered fallback locators in priority order (most stable first)",
          "items": {
            "type": "string"
          },
          "title": "Fallback Locators",
          "type": "array"
        },
        "fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ElementFingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DOM fingerprint captured on last successful interaction; used by healer when all locators fail"
        }
      },
      "required": [
        "description",
        "primary_locator"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "description": "One atomic browser action in a TestPlan.",
  "properties": {
    "step_id": {
      "description": "Stable, unique identifier within the plan",
      "title": "Step Id",
      "type": "string"
    },
    "action": {
      "$ref": "#/$defs/ActionType",
      "description": "Browser action to perform"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Target"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Element to act on; None for actions that don't require one (e.g. wait_for)"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Input value for fill/press/select/goto (URL for goto)",
      "title": "Value"
    },
    "expected": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Expected value for assert_* actions",
      "title": "Expected"
    },
    "timeout_ms": {
      "default": 5000,
      "description": "Per-step timeout in milliseconds",
      "minimum": 0,
      "title": "Timeout Ms",
      "type": "integer"
    }
  },
  "required": [
    "step_id",
    "action"
  ],
  "title": "Step",
  "type": "object"
}