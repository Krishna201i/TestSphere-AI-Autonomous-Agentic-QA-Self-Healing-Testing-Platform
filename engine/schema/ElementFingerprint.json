{
  "$defs": {
    "BoundingBox": {
      "description": "Pixel coordinates and dimensions of an element in the viewport.",
      "properties": {
        "x": {
          "description": "Left edge, pixels from viewport origin",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Top edge, pixels from viewport origin",
          "title": "Y",
          "type": "number"
        },
        "width": {
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "minimum": 0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    }
  },
  "description": "Rich DOM snapshot captured when an element is successfully located.\n\nUsed by the healer to score live-DOM candidates against a previously\nknown element, even after the original locator breaks.",
  "properties": {
    "tag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "HTML tag name, lower-cased (e.g. 'button')",
      "title": "Tag"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Element id attribute",
      "title": "Id"
    },
    "classes": {
      "description": "CSS class list",
      "items": {
        "type": "string"
      },
      "title": "Classes",
      "type": "array"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Visible inner text, stripped",
      "title": "Text"
    },
    "role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ARIA role attribute or implicit role",
      "title": "Role"
    },
    "aria_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "aria-label attribute value",
      "title": "Aria Label"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "name attribute (inputs, forms, etc.)",
      "title": "Name"
    },
    "placeholder": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "placeholder attribute",
      "title": "Placeholder"
    },
    "attributes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Any other relevant HTML attributes (data-*, type, href, ...)",
      "title": "Attributes",
      "type": "object"
    },
    "parent_chain": {
      "description": "Ordered list of ancestor tag#id.class strings, nearest first",
      "items": {
        "type": "string"
      },
      "title": "Parent Chain",
      "type": "array"
    },
    "sibling_index": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "0-based index among same-tag siblings within the parent",
      "title": "Sibling Index"
    },
    "bounding_box": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundingBox"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Viewport bounding box at time of capture"
    }
  },
  "title": "ElementFingerprint",
  "type": "object"
}