# ============================================================
# TestSphere-AI — Complete Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE (Firebase Cloud Firestore)
# ------------------------------------------------------------
# Backend: "firestore" (production), "local" (JSON file for offline dev),
# or "memory" (tests). Defaults to firestore when FIREBASE_CREDENTIALS is
# set, otherwise local.
# DATABASE_BACKEND=firestore
#
# Service-account key: Firebase console -> Project settings -> Service
# accounts -> Generate new private key. Paste the WHOLE JSON on one line,
# or give a path to the downloaded file. Keep it secret.
FIREBASE_CREDENTIALS=
# Optional; read from the key when omitted.
# FIREBASE_PROJECT_ID=your-project-id
#
# Offline local database file (DATABASE_BACKEND=local):
# LOCAL_DB_PATH=./data/local_db.json

# --- Sign-in (Firebase Authentication) ---
# Required by default once FIREBASE_CREDENTIALS is set; false = single local user.
# A hosted server without credentials refuses to start unless this is set to false.
# AUTH_REQUIRED=true
# Public web API key for the login page: Firebase console -> Project settings ->
# General -> Your apps -> Web app (create one if the list is empty).
FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# --- Automated pipeline ---
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_SECONDS=60
# Lets an external cron call POST /api/pipelines/scheduler/tick (X-Cron-Secret header)
# CRON_SECRET=

# ------------------------------------------------------------
# 2. BACKEND API SERVER (FastAPI)
# ------------------------------------------------------------
APP_ENV=development
DEBUG=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------------------------------------------------------------
# 3. AUTONOMOUS AGENT & LLM CONFIGURATION
# ------------------------------------------------------------
# Provider options:
#   - "mock"  : Deterministic offline mode (No API key needed, default)
#   - "chain" : Fallback chain, largest context window first: Gemini -> NVIDIA Nemotron -> NVIDIA Gemma -> Groq (see below)
#   - "api"   : One cloud LLM provider (OpenAI, Gemini, Anthropic, OpenRouter)
#   - "local" : Local OpenAI-compatible server (Ollama, vLLM, LM Studio); no API key.
#               LLM_BASE_URL defaults to Ollama at http://localhost:11434/v1
#
# --- Fallback chain (LLM_PROVIDER=chain) ---
# Each request goes to the first provider that can answer. One that hits its
# rate limit or quota is left out until the limit resets (an hour for a used-up
# daily quota), so the rest of the work continues on the next one. Providers
# without a key are skipped. Check them all with: cd backend && python -m agents.llm.check
# LLM_CHAIN=gemini,nvidia-nemotron,nvidia-gemma,groq
# NVIDIA (build.nvidia.com): one key for both, or one per model
# NVIDIA_API_KEY=
# NVIDIA_GEMMA_API_KEY=
# NVIDIA_NEMOTRON_API_KEY=
# NVIDIA_GEMMA_MODEL=google/gemma-4-31b-it
# NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Nemotron's reasoning ("thinking") is slower and spends tokens before the answer; off by default
# NVIDIA_NEMOTRON_THINKING=false
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Required only if LLM_PROVIDER=api. This project runs on Groq:
#   LLM_PROVIDER=api
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Any OpenAI-compatible endpoint; defaults to OpenAI. Examples:
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#   Groq   : https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
# LLM_BASE_URL=https://api.openai.com/v1
# Tokens one pipeline run may spend on the model in total (0 = no limit); past
# it the run carries on with the rule-based planner and healer
# LLM_MAX_TOKENS_PER_RUN=300000

# Agent healing memory: "database" (default) persists healing history in the
# configured database (DATABASE_BACKEND) so it survives restarts; "memory"
# keeps it in-process only.
AGENT_MEMORY_BACKEND=database

# Codebase ingestion: clone workspace, allowed Git hosts, and whether local
# folder paths are accepted (default: only when APP_ENV=development).
# INGEST_WORKSPACE=./data/repos
# INGEST_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# INGEST_ALLOW_LOCAL_PATHS=true

# The repository's own unit tests in each run: its CI results (GitHub), else the
# sandbox (throwaway Docker containers; needs Docker; see docs/deployment-operations.md)
# UNIT_TESTS=auto
# UNIT_TESTS_CI_WAIT=300
# SANDBOX_ENABLED=false
# AI fixes for failing repository tests, verified in the sandbox before anyone sees them
# AI_TEST_FIX=auto

# Security scanning. Passive scans (one GET per page, like a browser visit) may
# target any public site; private/internal addresses stay blocked when hosted.
# Set false to limit passive scans to the allow-list below as well.
# SECURITY_PASSIVE_ANY_HOST=true
# Hosts you own that active scans and the /.git and /.env probes may contact,
# comma-separated. Loopback is always allowed.
# SECURITY_SCAN_ALLOWED_HOSTS=staging.example.com,127.0.0.1:5173
SECURITY_SCAN_ALLOWED_HOSTS=
# Active (DAST) scanning sends test attacks; off by default. Enable only for hosts you may attack.
# SECURITY_ACTIVE_SCAN=true
# With sign-in on, any account may actively scan the sites it verified (Security -> Sites for active testing).
# Optional: Firebase uids (comma-separated) to narrow active scanning to those accounts.
# SECURITY_ACTIVE_SCAN_USERS=
# Active scans need proof the account owns the host (a token at
# /.well-known/testsphere-verify.txt): "auto" (on for a hosted server with sign-in), "on" or "off".
# REQUIRE_DOMAIN_VERIFICATION=auto
# AI triage of findings (prioritize, explain, draft fixes). "auto" uses it when
# a real LLM provider is set, else "on"/"off". It only reasons over findings the
# scanner already produced in scope — it never contacts the target.
# SECURITY_AI=auto

# Abuse limits: runs/scans/clones each user may start per minute (0 = off),
# and how many Chromium browsers may run at once (each needs ~150-300 MB).
# RATE_LIMIT_RUNS_PER_MINUTE=10
# ENGINE_MAX_BROWSERS=2

# Contact for data/privacy requests, shown on the dashboard's privacy notice.
# PRIVACY_CONTACT=privacy@your-domain.example

# Logging: level, and json (one object per line; default when hosted) or text.
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# Error reporting to Sentry (optional): the project's DSN.
# SENTRY_DSN=

# --- Hosted servers ---
# Fernet key that encrypts stored integration tokens (GitHub). REQUIRED on a
# hosted server, or connecting an integration fails; local development
# generates data/.token_key. Never change it once set, or stored tokens are lost.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Screenshots, DOM snapshots and traces: "local" (ARTIFACTS_DIR), "s3" or "gcs".
# Use a bucket when the server is redeployed or runs a separate worker.
# ARTIFACT_STORE=local
# ARTIFACT_BUCKET=
# ARTIFACT_RETENTION_DAYS=30
# Dashboard's public address, used for links in notifications (Slack).
# DASHBOARD_URL=https://dashboard.example.com
# Whether tests may target private/internal addresses (localhost, 10.x, 169.254.x).
# Defaults to off on hosted servers (SSRF protection), on in local development.
# ALLOW_PRIVATE_TARGETS=false

# ------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Vite React)
# ------------------------------------------------------------
# When deploying frontend and backend to separate domains:
# VITE_API_URL=https://api.example.com
# When running locally with dev proxy on port 3000, leave unset.
VITE_API_URL=
# ...and allow that frontend's origin on the backend (comma-separated):
# CORS_ORIGINS=https://dashboard.example.com
