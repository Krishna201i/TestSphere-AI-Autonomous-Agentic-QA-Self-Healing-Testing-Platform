# ============================================================
# TestSphere-AI — Complete Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase / PostgreSQL / SQLite)
# ------------------------------------------------------------
# Format for PostgreSQL / Supabase:
# postgresql://postgres:<ENCODED_PASSWORD>@<HOST>:<PORT>/postgres
# (Note: URL-encode special characters like '#' as '%23')
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
# For local offline SQLite fallback:
# DATABASE_URL=sqlite:///./testsphere.db

# ------------------------------------------------------------
# 2. BACKEND API SERVER (FastAPI)
# ------------------------------------------------------------
APP_ENV=development
DEBUG=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------------------------------------------------------------
# 3. AUTONOMOUS AGENT & LLM CONFIGURATION
# ------------------------------------------------------------
# Provider options:
#   - "mock"  : Deterministic offline mode (No API key needed, default)
#   - "api"   : Cloud LLM providers (OpenAI, Gemini, Anthropic, OpenRouter)
#   - "local" : Local Ollama or vLLM endpoints
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Required only if LLM_PROVIDER=api:
LLM_API_KEY=
# Optional custom base URL (e.g. OpenAI proxy, Groq, Ollama):
# LLM_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Vite React)
# ------------------------------------------------------------
# When deploying frontend and backend to separate domains:
# VITE_API_URL=https://your-backend-api.onrender.com
# When running locally with dev proxy on port 3000, leave unset.
VITE_API_URL=
