# ============================================================
# TestSphere-AI — Complete Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE (Firebase Cloud Firestore)
# ------------------------------------------------------------
# Backend: "firestore" (production), "local" (JSON file for offline dev),
# or "memory" (tests). Defaults to firestore when FIREBASE_CREDENTIALS is
# set, otherwise local.
# DATABASE_BACKEND=firestore
#
# Service-account key: Firebase console -> Project settings -> Service
# accounts -> Generate new private key. Paste the WHOLE JSON on one line,
# or give a path to the downloaded file. Keep it secret.
FIREBASE_CREDENTIALS=
# Optional; read from the key when omitted.
# FIREBASE_PROJECT_ID=your-project-id
#
# Offline local database file (DATABASE_BACKEND=local):
# LOCAL_DB_PATH=./data/local_db.json

# --- Sign-in (Firebase Authentication) ---
# Required by default once FIREBASE_CREDENTIALS is set; false = single local user.
# AUTH_REQUIRED=true
# Public web API key for the login page: Firebase console -> Project settings ->
# General -> Your apps -> Web app (create one if the list is empty).
FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# --- Automated pipeline ---
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_SECONDS=60
# Lets an external cron call POST /api/pipelines/scheduler/tick (X-Cron-Secret header)
# CRON_SECRET=

# ------------------------------------------------------------
# 2. BACKEND API SERVER (FastAPI)
# ------------------------------------------------------------
APP_ENV=development
DEBUG=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------------------------------------------------------------
# 3. AUTONOMOUS AGENT & LLM CONFIGURATION
# ------------------------------------------------------------
# Provider options:
#   - "mock"  : Deterministic offline mode (No API key needed, default)
#   - "api"   : Cloud LLM providers (OpenAI, Gemini, Anthropic, OpenRouter)
#   - "local" : Local Ollama or vLLM endpoints
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Required only if LLM_PROVIDER=api (set LLM_MODEL to a real model, e.g. gpt-4o-mini):
LLM_API_KEY=
# Any OpenAI-compatible endpoint; defaults to OpenAI. Examples:
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#   Groq   : https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
# LLM_BASE_URL=https://api.openai.com/v1

# Agent healing memory: "database" (default) persists healing history in
# DATABASE_URL so it survives restarts; "memory" keeps it in-process only.
AGENT_MEMORY_BACKEND=database

# Codebase ingestion: clone workspace, allowed Git hosts, and whether local
# folder paths are accepted (default: only when APP_ENV=development).
# INGEST_WORKSPACE=./data/repos
# INGEST_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# INGEST_ALLOW_LOCAL_PATHS=true

# Security scanning (passive): extra hosts the scanner may contact,
# comma-separated. Loopback is always allowed. Only list hosts you own.
# SECURITY_SCAN_ALLOWED_HOSTS=staging.example.com,127.0.0.1:5173
SECURITY_SCAN_ALLOWED_HOSTS=

# ------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Vite React)
# ------------------------------------------------------------
# When deploying frontend and backend to separate domains:
# VITE_API_URL=https://your-backend-api.onrender.com
# When running locally with dev proxy on port 3000, leave unset.
VITE_API_URL=
