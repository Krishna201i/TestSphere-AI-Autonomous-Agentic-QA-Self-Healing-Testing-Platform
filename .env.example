# --- LLM Configuration ---
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# --- Logging ---
LOG_LEVEL=INFO

# --- Application ---
APP_ENV=development
