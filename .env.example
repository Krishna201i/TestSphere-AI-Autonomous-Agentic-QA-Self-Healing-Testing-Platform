# ============================================================
# TestSphere-AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- LLM Provider ---
# Provider: "mock" (default, no deps), "local" (future), "api" (future)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# --- Future Provider Configuration (not required for mock) ---
# LLM_API_KEY=
# LLM_BASE_URL=

# --- Logging ---
LOG_LEVEL=INFO

# --- Application ---
APP_ENV=development
